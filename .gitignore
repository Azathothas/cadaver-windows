# Generated by configure / autogen.sh, all at the top level.
# These entries are anchored with a leading slash on purpose: an
# unanchored "config.h" also matches win32/config.h, which is a
# checked-in source file.
/Makefile
/config.h
/config.h.in
/config.log
/config.status
/configure
/configure~
/aclocal.m4
/autom4te.cache/
/neon/src/Makefile

# The scratch directory win32/regen-config.sh falls back to when mktemp
# is unavailable.
/regen-config.*

# The executable (Unix name; the .exe form is covered below).
/cadaver

# Build output.
*.o
*.a
*.exe
*~

# The second-opinion WebDAV server, built by tests/godav.sh.
/tests/godav/godav

# Scratch directories the test scripts write.
/godav-results/
/session-results/
/globtest-work/

# Local WebDAV server used by tests/wsgidav.sh.
/dav-venv/
/davroot/
